{
    // ============================================================
    //  redcli benchmark configuration (built-in default)
    //  Generated by: redcli init
    //  Comments (//) are for human reference only.
    // ============================================================

    // Input .dif file (mode 0) or folder of *.dif files (mode 1)
    "input": "",

    // Input mode: 0 = single file, 1 = folder
    "mode": 0,

    // CSV / log output directory (created if missing)
    "output_path": "build/out",

    // Number of timing repeats per algorithm
    "repeat": 3,

    // Round-trip verify: 1 = memcmp check + check timing, 0 = skip check
    "check_enabled": 1,

    // Pixel pitch in micrometres (um)
    "pitch_width_um": 0.5,

    // Oblique factor N
    "oblique_factor": 32,

    // Phase-1 rasterize worker threads
    "raster_threads": 4,

    // Phase-2 encode worker threads (0 = use raster_threads)
    "encode_threads": 0,

    // Phase-3 decode worker threads (0 = use raster_threads)
    "decode_threads": 0,

    // Action switches: run encode / decode phase (1 = on, 0 = skip)
    "encode_enabled": 1,
    "decode_enabled": 1,

    // Stripe height in pixel rows
    "block_line": 512,

    // Stripe width px: 0 = ALIGN(cols*N + rows, align_mode)
    "strip_width": 0,

    // Bit alignment mode: 8, 32, 64, 512, etc.
    "align_mode": 512,

    // DMD resolution rows
    "dmd_resolution_rows": 512,

    // DMD resolution cols
    "dmd_resolution_cols": 1920,

    // Format IDs: 0=RLE4K,1=GZIP,2=LZO2,3=SNAPPY,4=ZSTD,5=BROTLI
    "formats": [0, 1, 2, 3, 4, 5],

    // ---- Per-codec compression parameters ----

    "gzip_level": 6,
    "zstd_level": 3,
    "lzo2_level": 1,
    "snappy_level": 0,
    "brotli_level": 6,
    "brotli_window": 22,

    // Verbose level: "file" (summary) or "strip" (per-stripe detail)
    "verbose": "file"

}
